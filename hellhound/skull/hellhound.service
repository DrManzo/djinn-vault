[Unit]
Description=Hellhound Master Daemon
Documentation=https://github.com/DrManzo/djinn-vault
After=network.target
Requires=hellhound.socket

[Service]
Type=simple
WorkingDirectory=%h/.local/share/hellhound
ExecStart=/home/drmanzo/.pyenv/versions/3.11.11/bin/python3 %h/.local/share/hellhound/hellhound.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hellhound

# Security hardening
NoNewPrivileges=true
ProtectHome=read-only
ReadWritePaths=%h/.local/share/hellhound %h/Obsidian/hellhound

[Install]
WantedBy=default.target
