[Unit]
Description=Hellhound Pup: %I
Documentation=https://github.com/DrManzo/djinn-vault
After=hellhound.service
BindsTo=hellhound.service

[Service]
Type=simple
WorkingDirectory=%h/.local/share/hellhound
ExecStart=/home/drmanzo/.pyenv/versions/3.11.11/bin/python3 %h/.local/share/hellhound/pup-%I.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hellhound-pup-%I

Environment=PUP_NAME=%I
EnvironmentFile=%h/.config/systemd/user/hellhound-%I.env

[Install]
WantedBy=hellhound.service
