# ── PRIVACY — never commit ────────────────────────────────────────────────────
personal/
forge/commissions/
forge/finance/
ai/marcus/*
!ai/marcus/INDEX.md

# ── RAW IMPORTS — local only ──────────────────────────────────────────────────
RAW/

# ── OBSIDIAN CACHE ────────────────────────────────────────────────────────────
.obsidian/workspace*
.obsidian/cache/
.obsidian/plugins/
.obsidian/themes/
.obsidian/.obsidian/

# ── BINARY PRINT FILES — Oroborus only ───────────────────────────────────────
*.stl
*.3mf
*.gcode
*.gco
*.step
*.f3d

# ── MEDIA BINARIES — GATEWAY.md rule #2: logos only, and only if <200KB ──────
# (gitignore can't enforce the size cap — that's a manual review rule)
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.mp4
*.mov
!media/logos/**

# ── ARCHIVES & LARGE FILES ────────────────────────────────────────────────────
OLD/
*.zip
*.tar.gz
*.tgz
*.iso
*.rom
*.nds
*.n64

# ── SECRETS ───────────────────────────────────────────────────────────────────
*.env
.config/djinn/telegram.env
.config/djinn/printer-bot.env

# ── OS / EDITOR JUNK ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.Trash-*/

# ── PYTHON ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc

# ── CODEBASES — belong in their own repos, not the vault ─────────────────────
forge/projects/voice-app/
forge/projects/lblack/

# ── TEMP / SEARCH ─────────────────────────────────────────────────────────────
result.json
search/*.md
