# Raw exports (large, preserve locally)
RAW/

# Obsidian cache
.obsidian/workspace*
.obsidian/cache/
.obsidian/plugins/
.obsidian/themes/
.obsidian/.obsidian/

# Large archives
*.zip
*.tar.gz
*.tgz

# OS files
.DS_Store
Thumbs.db

# Temp files
*.swp
*.swo
*~

# Never commit these — large files, system junk, unrelated directories
OLD/
Obsidian/
Obsidian_archive/
backup-Djinn/
forge/
forge_archive/
.Trash-*/
*.nds
*.n64
*.iso
*.rom
RAW/

# Secrets — never commit
.config/djinn/telegram.env
.config/djinn/printer-bot.env
*.env

# Workspace symlink — tracked as symlink, not content
djinn/workspace

# Printer binary files — never commit STLs/gcodes/3mfs to vault
djinn/printer/queue/*.gcode
djinn/printer/queue/*.gco
djinn/printer/originals/*.stl
djinn/printer/originals/*.3mf
djinn/printer/finished-prints/*.gcode
djinn/printer/finished-prints/*.gco
djinn/printer/finished-prints/*.stl
djinn/printer/prints/**/*.stl
djinn/printer/prints/**/*.3mf

# Large STL files in coin library (>50MB — too large for GitHub)
djinn/printer/library/typhons-forge-coin/*.stl

# Temp output files
result.json
search/*.md

__pycache__/
personal/black-book/
personal/
