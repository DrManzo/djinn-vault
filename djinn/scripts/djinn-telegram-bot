#!/usr/bin/env python3
"""djinn-telegram-bot — Djinn print control via Telegram. Runs on Typhon."""

import os, asyncio, aiohttp
from pathlib import Path
from telegram import Update
from telegram.ext import Application, CommandHandler, ContextTypes

MOONRAKER_URL = os.environ["MOONRAKER_URL"]
VAULT_PATH    = Path(os.environ.get("VAULT_PATH", Path.home() / "Obsidian"))
ALLOWED_ID    = int(os.environ.get("ALLOWED_CHAT_ID", "0"))


def guard(update: Update) -> bool:
    return ALLOWED_ID == 0 or update.effective_chat.id == ALLOWED_ID


async def _get(session, path):
    async with session.get(f"{MOONRAKER_URL}{path}", timeout=aiohttp.ClientTimeout(total=8)) as r:
        return await r.json()


async def _post(session, path, body=None):
    async with session.post(f"{MOONRAKER_URL}{path}", json=body or {}, timeout=aiohttp.ClientTimeout(total=8)) as r:
        return await r.json()


async def cmd_print(update: Update, ctx: ContextTypes.DEFAULT_TYPE):
    if not guard(update):
        return
    if not ctx.args:
        await update.message.reply_text("Usage: /print <filename>")
        return
    filename = ctx.args[0]
    async with aiohttp.ClientSession() as s:
        try:
            resp = await _post(s, "/printer/print/start", {"filename": filename})
            if resp.get("result") == "ok":
                await update.message.reply_text(f"Print started: {filename}")
            else:
                await update.message.reply_text(f"Moonraker error: {resp}")
        except Exception as e:
            await update.message.reply_text(f"Error: {e}")


async def cmd_print_status(update: Update, ctx: ContextTypes.DEFAULT_TYPE):
    if not guard(update):
        return
    async with aiohttp.ClientSession() as s:
        try:
            resp = await _get(s, "/printer/objects/query?print_stats&extruder&heater_bed")
            status = resp["result"]["status"]
            ps  = status.get("print_stats", {})
            ext = status.get("extruder", {})
            bed = status.get("heater_bed", {})
            state    = ps.get("state", "unknown")
            filename = ps.get("filename", "none")
            duration = int(ps.get("print_duration", 0) // 60)
            progress = ps.get("progress", 0) * 100
            hotend   = ext.get("temperature", 0)
            bed_temp = bed.get("temperature", 0)
            msg = (
                f"State: {state}\n"
                f"File: {filename}\n"
                f"Progress: {progress:.1f}%\n"
                f"Duration: {duration}m\n"
                f"Hotend: {hotend:.1f}C\n"
                f"Bed: {bed_temp:.1f}C"
            )
            await update.message.reply_text(msg)
        except Exception as e:
            await update.message.reply_text(f"Error: {e}")


async def cmd_print_cancel(update: Update, ctx: ContextTypes.DEFAULT_TYPE):
    if not guard(update):
        return
    async with aiohttp.ClientSession() as s:
        try:
            resp = await _post(s, "/printer/print/cancel")
            if resp.get("result") == "ok":
                await update.message.reply_text("Print cancelled.")
            else:
                await update.message.reply_text(f"Failed: {resp}")
        except Exception as e:
            await update.message.reply_text(f"Error: {e}")


async def cmd_print_queue(update: Update, ctx: ContextTypes.DEFAULT_TYPE):
    if not guard(update):
        return
    async with aiohttp.ClientSession() as s:
        try:
            resp = await _get(s, "/server/files/list?root=gcodes")
            files = resp.get("result", [])
            if not files:
                await update.message.reply_text("No files on printer.")
                return
            names = [f["filename"] for f in sorted(files, key=lambda x: x.get("modified", 0), reverse=True)[:10]]
            await update.message.reply_text("Files on printer (newest first):\n" + "\n".join(names))
        except Exception as e:
            await update.message.reply_text(f"Error: {e}")


async def cmd_print_log(update: Update, ctx: ContextTypes.DEFAULT_TYPE):
    if not guard(update):
        return
    async with aiohttp.ClientSession() as s:
        try:
            resp = await _get(s, "/server/history/list?limit=5&order=desc")
            jobs = resp.get("result", {}).get("jobs", [])
            if not jobs:
                await update.message.reply_text("No print history.")
                return
            lines = []
            for j in jobs:
                fname    = j.get("filename", "?")
                status   = j.get("status", "?")
                start    = j.get("start_time", 0)
                end      = j.get("end_time", 0)
                duration = f"{int((end - start) // 60)}m" if end and start else "?"
                lines.append(f"{fname} — {status} ({duration})")
            await update.message.reply_text("Last 5 prints:\n" + "\n".join(lines))
        except Exception as e:
            await update.message.reply_text(f"Error: {e}")


def main():
    token = os.environ["TELEGRAM_BOT_TOKEN"]
    app = Application.builder().token(token).build()
    app.add_handler(CommandHandler("print",         cmd_print))
    app.add_handler(CommandHandler("print_status",  cmd_print_status))
    app.add_handler(CommandHandler("print_cancel",  cmd_print_cancel))
    app.add_handler(CommandHandler("print_queue",   cmd_print_queue))
    app.add_handler(CommandHandler("print_log",     cmd_print_log))
    print(f"djinn-telegram-bot started — Moonraker: {MOONRAKER_URL}")
    app.run_polling(allowed_updates=Update.ALL_TYPES)


if __name__ == "__main__":
    main()
