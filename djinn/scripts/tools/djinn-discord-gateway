_PROFILE_MAP = {
    "a": "standard", "b": "production", "c": "proto",
    "standard": "standard", "production": "production", "proto": "proto",
    "quality": "production", "draft": "proto",
}


def _parse_order_caption(caption: str) -> tuple:
    """
    Parse a customer's file caption into (profile_key, color, note).
    Accepts: 'B white', 'B white - no rush', 'A blue gaming fig', etc.
    Returns empty strings for any part that wasn't found.
    """
    if not caption:
        return "", "", ""
    m = re.match(
        r'^([ABCabc]|proto|standard|production|quality|draft)'
        r'\s+(white|blue|red|black)'
        r'(?:\s*[-—]\s*(.+))?$',
        caption.strip(), re.I
    )
    if m:
        profile = _PROFILE_MAP.get(m.group(1).lower(), "standard")
        color   = m.group(2).lower()
        note    = (m.group(3) or "").strip()
        return profile, color, note
    # No profile/color match — whole caption is a note
    return "", "", caption.strip()

