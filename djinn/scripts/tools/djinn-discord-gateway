        return f"Could not read queue: {e}"

    # Apply maker's mark before slicing — mandatory on every commission print
    if model_path and not model_path.endswith("_bored.stl"):
        mark_out, mark_err, mark_rc = run_shell(
            f"djinn-model-mark {model_path}", timeout=120
        )
        if mark_rc != 0:
            log.warning("maker's mark failed: %s", mark_err[:200])
            return "Maker's mark step failed — check logs on Salomon."

        # Parse marked STL path from djinn-model-mark stdout: "  Saved:  /path/to/marked.stl"
        marked_path = None
        for line in mark_out.splitlines():
            if "Saved:" in line:
                marked_path = line.split("Saved:")[-1].strip()
                break

        if marked_path and pathlib.Path(marked_path).exists():
            # Update queue entry to point at the marked file
            for q_job in q_data["jobs"]:
                if q_job["id"] == job_id:
                    q_job["model_path"]           = marked_path
                    q_job["customer_profile"]     = profile_key
                    q_job["filament_type"]        = material
                    q_job["customer_color"]       = color
                    q_job["status"]               = "confirmed"
                    q_job["customer_discord_id"]  = discord_user_id
                    q_job["customer_discord_name"] = discord_username
                    break
            queue_path.write_text(json.dumps(q_data, indent=2))
        else:
            log.warning("mark ran but no Saved: path found in output — using original STL")
            for q_job in q_data["jobs"]:
                if q_job["id"] == job_id:
                    q_job["customer_profile"]     = profile_key
                    q_job["filament_type"]        = material
                    q_job["customer_color"]       = color
                    q_job["status"]               = "confirmed"
                    q_job["customer_discord_id"]  = discord_user_id
                    q_job["customer_discord_name"] = discord_username
                    break
            queue_path.write_text(json.dumps(q_data, indent=2))
    else:
        # _bored files already have mark on bore floor — just update settings
        for q_job in q_data["jobs"]:
            if q_job["id"] == job_id:
                q_job["customer_profile"]     = profile_key
                q_job["filament_type"]        = material
                q_job["customer_color"]       = color
                q_job["status"]               = "confirmed"
                q_job["customer_discord_id"]  = discord_user_id
                q_job["customer_discord_name"] = discord_username
                break
        queue_path.write_text(json.dumps(q_data, indent=2))

    # Build slice command — include color so Javier knows which spool to load
    slice_cmd = f"djinn-model-slice {job_id} {profile_key} material={material}"
    if color:
        slice_cmd += f" color={color}"

    # Trigger slice (runs in background, sends results directly via Discord)
    out, err, rc = run_shell(slice_cmd, timeout=300)
    if rc != 0:
        log.warning("slice failed: %s", err[:200])
        return "Something went wrong slicing your file — we'll look into it."
    return ""  # djinn-model-slice sends its own Discord message


def handle_customer_order_notify(discord_user_id: str, discord_username: str) -> str:
    """Customer typed `order` — notify Javier on Telegram with confirm/deny."""
    try:
        q_data = json.loads(pathlib.Path.home().joinpath(
            ".local/share/djinn/print-queue.json").read_text())
        jobs = [j for j in q_data.get("jobs", []) if j.get("status") == "pending"]
        if not jobs:
            return "No print is ready to confirm yet — pick a profile first (e.g. `A pla`)."
        job = jobs[-1]
        job_id  = job["id"]
        name    = pathlib.Path(job.get("model_path", "unknown")).stem
        profile = job.get("profile", "standard")
        material= job.get("material", "pla").upper()
        stats   = job.get("stats") or {}
        time_s  = stats.get("estimated_time", "?")
        quote   = job.get("quote") or {}
        price_s = f"${quote['price']:.2f}" if quote.get("price") else "—"
    except Exception as e:
        return f"Could not read queue: {e}"

    # Ping Javier on Telegram
    tg_msg = "\n".join([
        f"🛒 Order received — Job #{job_id}",
        f"Customer:  @{discord_username}",
        f"Model:     {name}",
        f"Profile:   {profile.capitalize()} + {material}",
        f"Time:      {time_s}",
        f"Price:     {price_s}",
        "",
        f"confirm {job_id}  ←  start print",
        f"deny {job_id}     ←  reject",
    ])
    import urllib.request as _ur
    try:
        _tg_env = {}
        for line in pathlib.Path.home().joinpath(".config/djinn/printer-bot.env").read_text().splitlines():
            if "=" in line and not line.startswith("#"):
                k, _, v = line.partition("=")
                _tg_env[k.strip()] = v.strip()
        tok  = _tg_env.get("TELEGRAM_BOT_TOKEN", "")
        chat = _tg_env.get("TELEGRAM_CHAT_ID", "")
        if tok and chat:
            data = json.dumps({"chat_id": chat, "text": tg_msg}).encode()
            _ur.urlopen(_ur.Request(
                f"https://api.telegram.org/bot{tok}/sendMessage",
                data=data, headers={"Content-Type": "application/json"}
            ), timeout=10)
    except Exception as e:
        log.warning("order tg notify failed: %s", e)

    return "Order received — we'll review and start your print shortly. — Typhon's Forge"


