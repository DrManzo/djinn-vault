intents = discord.Intents.default()
intents.message_content = True
client = discord.Client(intents=intents)


@client.event
async def on_ready():
    log.info("Djinn Discord gateway ready — %s", client.user)
    log.info("Routing: %d channels mapped", len(CHANNEL_CTX))


@client.event
async def on_message(message: discord.Message):
    if message.author == client.user:
        return
    # ── Customer ORDER/EXPRESS + DM handling (SHOP_PATCH_APPLIED) ─────────────
    if message.author.id != ALLOWED_USER:
        import discord as _dc
        _is_print   = CHANNEL_CTX.get(message.channel.id) == "print"
        _text       = message.content.strip()
        _text_lower = _text.lower()
        _is_order   = _text_lower in ("order", "express")
        _is_profile = bool(re.match(
            r'^([ABCabc]|proto|standard|production|quality|draft)'
            r'\s+(white|blue|red|black|pla|petg|abs|tpu)$',
            _text, re.I))
        _is_dm = isinstance(message.channel, _dc.DMChannel)

        # ── STL/3MF attachment — single-shot order ────────────────────────────
        _stl_atts = [
            a for a in message.attachments
            if a.filename.lower().endswith((".stl", ".3mf"))
        ] if _is_print else []
        if _stl_atts:
            att = _stl_atts[0]
            profile, color, note = _parse_order_caption(_text)
            if profile and color:
                ack = "Got your file — we're reviewing it. We'll confirm shortly.\n— Typhon's Forge"
            else:
                ack = (
                    "Got your file!\n\n"
                    "To complete your order, include your choice with the file:\n"
                    "```\nB white\nA blue - no rush\nC black\n```\n"
                    "See the pinned guide for all options."
                )
            await message.channel.send(ack)
            cmd = f"djinn-model-fetch {att.url!r}"
            if profile: cmd += f" --profile {profile}"
            if color:   cmd += f" --color {color}"
            if note:    cmd += f" --note {note!r}"
            import asyncio
            asyncio.get_event_loop().run_in_executor(None, run_shell, cmd, 300)
            return

        _looks_like_profile = bool(re.match(r'^[ABCabc]\s+\S+$', _text, re.I))

        if _is_print and _is_profile:
            reply = handle_customer_profile_pick(_text, str(message.author), str(message.author.id))
            if reply:
                await message.channel.send(reply)
            return

        if _is_print and _looks_like_profile:
            await message.channel.send(
                "Format: `A white` — profile letter + color name.\n"
                "Colors: `white` · `blue` · `red` · `black`"
            )
            return

        if _is_print and _is_order:
            reply = handle_customer_order_notify(
                str(message.author.id), str(message.author))
            if reply:
                await message.channel.send(reply)
            return

        if _is_dm:
            try:
                from forge.shop.customer_dm import handle_dm_reply
                handle_dm_reply(str(message.author.id),
                                message.content, str(message.id))
            except Exception:
                pass
            return
        return
    # ── END SHOP PATCH ──────────────────────────────────────────────────────────

    if message.guild and message.guild.id != GUILD_ID:
        return

    channel_id = message.channel.id
    ctx = CHANNEL_CTX.get(channel_id, "ignore")

    if ctx in ("ignore", "readonly"):
        return

    # ── STL/3MF drop from Javier ──────────────────────────────────────────────
    if ctx == "print" and message.attachments:
        _stl_j = [a for a in message.attachments if a.filename.lower().endswith((".stl", ".3mf"))]
        if _stl_j:
            att = _stl_j[0]
            caption = message.content.strip()
            profile, color, note = _parse_order_caption(caption)
            cmd = f"djinn-model-fetch {att.url!r}"
            if profile: cmd += f" --profile {profile}"
            if color:   cmd += f" --color {color}"
            if note:    cmd += f" --note {note!r}"
            import asyncio
            asyncio.get_event_loop().run_in_executor(None, run_shell, cmd, 300)
            return


    text = message.content.strip()
    if not text:
        return

    log.info("← [#%s/%s] %r", message.channel, ctx, text[:80])

    # ── In print channel, profile picks work for Javier too ───────────────────
    if ctx == "print":
        _PROFILE_RE = re.compile(
            r'^([ABCabc]|proto|standard|production|quality|draft)'
            r'\s+(white|blue|red|black|pla|petg|abs|tpu)$', re.I)
        _LOOKS_RE = re.compile(r'^[ABCabc]\s+\S+$', re.I)
        if _PROFILE_RE.match(text):
            reply = handle_customer_profile_pick(text, str(message.author))
            if reply:
                await message.channel.send(reply)
            return
        if _LOOKS_RE.match(text):
            await message.channel.send(
                "Format: `A white` — profile letter + color name.\n"
                "Colors: `white` · `blue` · `red` · `black`"
            )
            return

        # ── snap: live AKASO camera shot ──────────────────────────────────────
        if text.lower() in ("snap", "snapshot"):
            import time, shutil, tempfile
            latest = Path.home() / "Videos/print-monitor/snapshots/latest.jpg"
            if latest.exists() and (time.time() - latest.stat().st_mtime) < 120:
                with tempfile.NamedTemporaryFile(suffix=".jpg", delete=False) as _tmp:
                    tmp_path = Path(_tmp.name)
                shutil.copy2(latest, tmp_path)
                await message.channel.send(
                    "📸 Calliope — live",
                    file=discord.File(str(tmp_path), filename="calliope_snap.jpg"),
                )
                tmp_path.unlink(missing_ok=True)
            else:
                await message.channel.send(
                    "❌ No recent frame — webcam monitor offline or camera disconnected."
                )
            return

    async with message.channel.typing():
        import asyncio
        loop = asyncio.get_event_loop()
        reply = await loop.run_in_executor(None, dispatch, text, ctx)

    if len(reply) > 1990:
        reply = reply[:1987] + "…"

    await message.channel.send(reply)
    log.info("→ [#%s] %r", message.channel, reply[:80])
    _log_exchange(text, reply)


def _log_exchange(user_text: str, bot_reply: str):
    log_dir = Path.home() / "Obsidian/djinn/logs/conversations"
    log_dir.mkdir(parents=True, exist_ok=True)
    today = datetime.now().strftime("%Y-%m-%d")
    log_file = log_dir / f"{today}.md"
    ts = datetime.now().strftime("%H:%M:%S")
    entry = f"\n### {ts}\n**Javier:** {user_text}\n**Djinn:** {bot_reply}\n"
    try:
        if not log_file.exists():
            log_file.write_text(f"# Djinn Discord Log — {today}\n")
        with log_file.open("a") as f:
            f.write(entry)
    except Exception as e:
        log.warning("_log_exchange failed: %s", e)


