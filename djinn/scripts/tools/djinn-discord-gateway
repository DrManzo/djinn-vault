ROUTES_BY_CTX = {
    "all":     ROUTES_SYSTEM + ROUTES_PRINT + ROUTES_DESIGN + ROUTES_MEDIA,
    "print":   ROUTES_SYSTEM + ROUTES_PRINT,
    "media":   ROUTES_SYSTEM + ROUTES_MEDIA,
    "general": ROUTES_SYSTEM,
}


def dispatch(text: str, channel_ctx: str) -> str:
    clean = text.strip().lstrip("/")
    routes = ROUTES_BY_CTX.get(channel_ctx, ROUTES_SYSTEM)
    for pattern, handler in routes:
        m = pattern.match(clean)
        if m:
            return sign(handler(m, text, channel_ctx))

    # No command match — pass to model (conversation)
    return sign(ask_model(text, channel_ctx=channel_ctx))

