def run_shell(cmd, timeout=30) -> tuple[str, str, int]:
    try:
        r = subprocess.run(
            cmd, shell=True, capture_output=True, text=True,
            timeout=timeout,
            env={**os.environ, "HOME": str(Path.home())}
        )
        return r.stdout.strip(), r.stderr.strip(), r.returncode
    except subprocess.TimeoutExpired:
        return "", "Command timed out.", 1
    except Exception as e:
        return "", str(e), 1


def get_ctx(query: str) -> str:
    try:
        r = subprocess.run(
            ["djinn-ctx-assembler", query, "--budget", "3000"],
            capture_output=True, text=True, timeout=10
        )
        return r.stdout.strip()
    except Exception:
        return ""


def ask_model(user_msg: str, context: str | None = None, channel_ctx: str = "all") -> str:
    djinn_ctx = get_ctx(user_msg)
    system = IDENTITY
    if djinn_ctx:
        system = f"{IDENTITY}\n\n[Vault context]\n{djinn_ctx}"

    messages = [{"role": "system", "content": system}]
    if context:
        messages.append({
            "role": "user",
            "content": (
                f"[Command output — format this for Javier. Be concise.]\n\n"
                f"{context}\n\n[Original command: {user_msg}]"
            )
        })
    else:
        messages.append({"role": "user", "content": user_msg})

    try:
        r = requests.post(
            GROQ_URL,
            json={"model": MODEL, "messages": messages, "temperature": 0.4, "max_tokens": 1024},
            headers={"Authorization": f"Bearer {_groq_key()}", "Content-Type": "application/json"},
            timeout=60,
        )
        r.raise_for_status()
        return r.json()["choices"][0]["message"]["content"].strip() or "— Djinn"
    except Exception as e:
        log.error("Groq error: %s — falling back to Ollama", e)
        try:
            fb = requests.post(
                "http://localhost:11434/api/chat",
                json={"model": "deepseek-r1:7b", "messages": messages, "stream": False,
                      "options": {"temperature": 0.4, "num_predict": 512}},
                timeout=60,
            )
            text = fb.json().get("message", {}).get("content", "").strip()
            return re.sub(r"<think>.*?</think>", "", text, flags=re.DOTALL).strip() or "— Djinn"
        except Exception as e2:
            return f"[Djinn unavailable: {e2}]"


def sign(text: str) -> str:
    t = text.rstrip()
    if not t.endswith("— Djinn"):
        t += "\n— Djinn"
    return t

