# ── Moonraker ──────────────────────────────────────────────────────────────────
def get_print_state():
    try:
        r = requests.get(
            f"{MOONRAKER}/printer/objects/query?print_stats",
            timeout=5
        )
        ps = r.json()["result"]["status"]["print_stats"]
        return ps["state"], ps["print_duration"]
    except Exception:
        return "unknown", 0.0


def gcode(script):
    try:
        r = requests.post(
            f"{MOONRAKER}/printer/gcode/script",
            json={"script": script},
            timeout=10
        )
        return r.ok
    except Exception as e:
        log.warning(f"gcode {script!r}: {e}")
        return False


