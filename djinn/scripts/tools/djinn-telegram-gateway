def handle_queue(_match, _raw):
    out, err, rc = run_shell("cat /home/drmanzo/.local/share/djinn/print-queue.json")
    if rc != 0 or not out:
        return ask_model("queue", context=f"Error reading print queue: {err or 'empty'}")
    try:
        data = json.loads(out)
        jobs = data.get("jobs", [])
        if not jobs:
            return "Print queue is empty. — Djinn"
        lines = ["Print queue:"]
        for j in jobs:
            jid = j.get("id", "?")
            status = j.get("status", "unknown")
            note = j.get("note") or os.path.basename(j.get("model_path", "unknown"))
            stats = j.get("stats") or {}
            t = stats.get("estimated_time", "")
            g = stats.get("filament_g", "")
            detail = f"{t} / {g}g" if t and g else t or ""
            lines.append(f"  #{jid} [{status}] {note}" + (f" — {detail}" if detail else ""))
        return "\n".join(lines) + "\n— Djinn"
    except json.JSONDecodeError:
        return ask_model("queue", context=out)

