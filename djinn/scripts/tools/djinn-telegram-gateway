_ANSI_RE = re.compile(r'\x1b\[[0-9;]*m')

def handle_gemini(match, _raw):
    subcmd = (match.group(1) or "").strip()
    if not subcmd:
        return (
            "Gemini commands:\n"
            "  /gemini ask \"prompt\"\n"
            "  /gemini youtube <url> \"prompt\"\n"
            "  /gemini url <url> \"prompt\"\n"
            "  /gemini doc <path> \"prompt\"\n"
            "  /gemini research --topic <slug> \"query\"\n"
            "— Djinn"
        )
    out, err, rc = run_shell(f"djinn-gemini {subcmd}", timeout=180)
    raw = _ANSI_RE.sub("", out or err or f"No output (rc={rc})").strip()
    # Drop header line ("Gemini  ...") and vault path lines
    lines = [
        l for l in raw.splitlines()
        if not l.strip().startswith("Saved →")
        and "Pushed to vault" not in l
        and not re.match(r'^Gemini\s{2,}', l)
    ]
    clean = "\n".join(lines).strip()
    if len(clean) > 3800:
        clean = clean[:3800] + "\n…[truncated]"
    if not clean.endswith("— Djinn"):
        clean += "\n— Djinn"
    return clean

