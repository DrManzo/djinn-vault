# ── Telegram helpers ──────────────────────────────────────────────────────────

def tg_get(method, params=None, timeout=35):
    r = requests.get(f"{TG_API}/{method}", params=params, timeout=timeout)
    r.raise_for_status()
    return r.json()

def tg_post(method, payload, timeout=35):
    r = requests.post(f"{TG_API}/{method}", json=payload, timeout=timeout)
    r.raise_for_status()
    return r.json()

def send(chat_id, text):
    if len(text) > 4096:
        text = text[:4090] + "\n…"
    tg_post("sendMessage", {"chat_id": chat_id, "text": text})

def send_typing(chat_id):
    try:
        tg_post("sendChatAction", {"chat_id": chat_id, "action": "typing"})
    except Exception:
        pass

def send_photo(chat_id, image_path: Path, caption: str = ""):
    try:
        with open(image_path, "rb") as f:
            requests.post(
                f"{TG_API}/sendPhoto",
                data={"chat_id": chat_id, "caption": caption},
                files={"photo": ("snap.jpg", f, "image/jpeg")},
                timeout=30,
            ).raise_for_status()
    except Exception as e:
        log.warning("send_photo failed: %s", e)
        send(chat_id, f"📸 snap failed: {e}")

def send_voice(chat_id, ogg_path: Path):
    """Send an OGG Opus voice message to chat_id."""
    try:
        with open(ogg_path, "rb") as f:
            requests.post(
                f"{TG_API}/sendVoice",
                data={"chat_id": chat_id},
                files={"voice": ("voice.ogg", f, "audio/ogg")},
                timeout=30,
            ).raise_for_status()
    except Exception as e:
        log.warning("send_voice failed: %s", e)

def transcribe_voice(file_id: str) -> str:
    """Download a Telegram voice message and transcribe via Groq Whisper."""
    try:
        # Get download URL
        info = tg_get("getFile", {"file_id": file_id})
        file_path = info["result"]["file_path"]
        url = f"https://api.telegram.org/file/bot{BOT_TOKEN}/{file_path}"
        audio_data = requests.get(url, timeout=30).content
        # Transcribe via Groq Whisper
        r = requests.post(
            GROQ_STT_URL,
            headers={"Authorization": f"Bearer {_groq_key()}"},
            files={"file": ("voice.ogg", audio_data, "audio/ogg")},
            data={"model": "whisper-large-v3-turbo", "response_format": "text"},
            timeout=30,
        )
        r.raise_for_status()
        return r.text.strip()
    except Exception as e:
        log.warning("transcribe_voice failed: %s", e)
        return ""

