# ── Typhon heartbeat staleness check ─────────────────────────────────────────

def check_typhon_heartbeat():
    hb_path = Path.home() / "Obsidian/djinn/communications/HEARTBEAT-typhon.md"
    if not hb_path.exists():
        return
    try:
        text = hb_path.read_text()
        for line in text.splitlines():
            if line.startswith("**Last beat:**"):
                raw = line.split("**Last beat:**", 1)[1].strip()
                from datetime import datetime, timezone, timedelta
                try:
                    beat_time = datetime.strptime(raw, "%Y-%m-%d %H:%M:%S UTC").replace(tzinfo=timezone.utc)
                    age = datetime.now(timezone.utc) - beat_time
                    if age > timedelta(hours=24):
                        msg = f"⚠️ Typhon heartbeat stale — last beat {raw} ({int(age.total_seconds()//3600)}h ago). Machine may be offline."
                        for uid in ALLOWED_IDS:
                            try:
                                send(uid, msg)
                            except Exception:
                                pass
                        log.warning("Typhon heartbeat stale: %s", raw)
                except ValueError:
                    pass
                break
    except Exception as e:
        log.warning("Typhon heartbeat check failed: %s", e)

# ── Claude queue check ────────────────────────────────────────────────────────

def check_claude_queue():
    queue_path = Path.home() / "Obsidian/djinn/communications/QUEUE.md"
    if not queue_path.exists():
        return
    try:
        text = queue_path.read_text()
        pending = []
        current_task = None
        assigned_claude = False
        status_pending = False
        in_code_block = False
        for line in text.splitlines():
            if line.strip().startswith("```"):
                in_code_block = not in_code_block
                continue
            if in_code_block:
                continue
            if line.startswith("## TASK-") and not line.strip().endswith("NNN"):
                if current_task and assigned_claude and status_pending:
                    pending.append(current_task)
                current_task = line[3:].strip()
                assigned_claude = False
                status_pending = False
            elif "assigned_to: claude" in line:
                assigned_claude = True
            elif "status: pending" in line:
                status_pending = True
        if current_task and assigned_claude and status_pending:
            pending.append(current_task)
        if pending:
            msg = f"⏳ Pending Claude tasks ({len(pending)}):\n" + "\n".join(f"• {t}" for t in pending)
            for uid in ALLOWED_IDS:
                try:
                    send(uid, msg)
                except Exception:
                    pass
            log.info("Sent Claude queue alert: %d pending tasks", len(pending))
    except Exception as e:
        log.warning("Claude queue check failed: %s", e)

# ── Main polling loop ─────────────────────────────────────────────────────────

def main():
    log.info("djinn-telegram-gateway starting (model=%s)", MODEL)
    check_typhon_heartbeat()
    check_claude_queue()
    offset = None

    while True:
        try:
            params = {"timeout": POLL_TIMEOUT, "allowed_updates": ["message"]}
            if offset is not None:
                params["offset"] = offset

            resp = tg_get("getUpdates", params, timeout=POLL_TIMEOUT + 5)
            updates = resp.get("result", [])

            for upd in updates:
                offset = upd["update_id"] + 1
                msg = upd.get("message")
                if not msg:
                    continue

                chat_id = msg["chat"]["id"]
                from_id = msg.get("from", {}).get("id")
                text = (msg.get("text") or "").strip()

                # Handle incoming voice messages — transcribe and treat as text
                if not text and msg.get("voice"):
                    file_id = msg["voice"]["file_id"]
                    if from_id not in ALLOWED_IDS:
                        continue
                    send_typing(chat_id)
                    transcript = transcribe_voice(file_id)
                    if transcript:
                        log.info("← [%s] voice→text: %r", from_id, transcript[:80])
                        scan_for_people_mentions(transcript)
                        try:
                            reply = dispatch(transcript)
                        except Exception as e:
                            log.exception("Dispatch error (voice): %s", e)
                            reply = f"[Error: {e}]\n— Djinn"
                        send(chat_id, f"🎙 {transcript}\n\n{reply}")
                        log_exchange(f"[voice] {transcript}", reply)
                        if VOICE_MODE and len(reply) < 800:
                            try:
                                ogg = Path("/tmp/djinn_voice_reply.ogg")
                                subprocess.run(
                                    ["djinn-gemini", "tts", reply, "--out", str(ogg)],
                                    capture_output=True, timeout=30
                                )
                                if ogg.exists():
                                    send_voice(chat_id, ogg)
                            except Exception as _ve:
                                log.warning("voice send failed: %s", _ve)
                    else:
                        send(chat_id, "Could not transcribe voice message.\n— Djinn")
                    continue

                if not text:
                    continue

                if from_id not in ALLOWED_IDS:
                    log.warning("Ignored message from unauthorized id=%s", from_id)
                    continue

                log.info("← [%s] %r", from_id, text[:80])
                send_typing(chat_id)
                scan_for_people_mentions(text)

                try:
                    reply = dispatch(text)
                except Exception as e:
                    log.exception("Dispatch error: %s", e)
                    reply = f"[Error: {e}]\n— Djinn"

                if not reply:
                    reply = "— Djinn"

                log.info("→ [%s] %r", chat_id, reply[:80])
                send(chat_id, reply)
                log_exchange(text, reply)
                if VOICE_MODE and len(reply) < 800:
                    try:
                        import subprocess as _sp
                        ogg = Path("/tmp/djinn_voice_reply.ogg")
                        _sp.run(
                            ["djinn-gemini", "tts", reply, "--out", str(ogg)],
                            capture_output=True, timeout=30
                        )
                        if ogg.exists():
                            send_voice(chat_id, ogg)
                    except Exception as _ve:
                        log.warning("voice send failed: %s", _ve)

        except requests.exceptions.Timeout:
            pass  # normal long-poll expiry
        except requests.exceptions.ConnectionError as e:
            log.error("Network error: %s — retrying in 5s", e)
            time.sleep(5)
        except KeyboardInterrupt:
            log.info("Shutting down.")
            sys.exit(0)
        except Exception as e:
            log.exception("Unhandled error: %s — retrying in 5s", e)
            time.sleep(5)

if __name__ == "__main__":
    main()
