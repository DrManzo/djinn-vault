        return "Could not read meeting schedule.\n— Djinn"
    if not meetings:
        return "Add your meetings to ~/.config/djinn/aa-meetings.json\n— Djinn"
    today = datetime.now().strftime("%A").lower()
    now_time = datetime.now().strftime("%H:%M")
    upcoming = [
        m for m in meetings
        if m.get("day","").lower() in ("daily", today)
        and m.get("time","") >= now_time
    ]
    upcoming.sort(key=lambda m: m.get("time",""))
    if not upcoming:
        return "No more meetings today. Check tomorrow's schedule.\n— Djinn"
    m = upcoming[0]
    link = f" — {m['link']}" if m.get("link") else ""
    return f"Next meeting: {m['name']} at {m['time']} on {m['platform']}.{link}\n— Djinn"

