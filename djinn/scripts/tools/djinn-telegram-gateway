def handle_monitor_status(_match, _raw):
    import pathlib
    state_file = pathlib.Path.home() / ".local/share/djinn/webcam-state.json"
    if not state_file.exists():
        return "Webcam monitor not running or no data yet.\n— Djinn"
    try:
        s = json.loads(state_file.read_text())
        mode  = s.get("mode", "unknown")
        pst   = s.get("print_state", "unknown")
        dur   = int(s.get("duration", 0))
        rec   = "recording" if s.get("recording") else "not recording"
        fail  = s.get("in_failure", False)
        h, r  = divmod(dur, 3600)
        m_min, sec = divmod(r, 60)
        dur_s = f"{h}h {m_min}m" if h else f"{m_min}m {sec}s"
        lines = [
            f"Webcam monitor: {mode}",
            f"Print state: {pst}  Duration: {dur_s}",
            f"Camera: {rec}",
        ]
        if fail:
            lines.append("⚠️ FAILURE STATE — printer paused")
        lines.append("— Djinn")
        return "\n".join(lines)
    except Exception as e:
        return f"Could not read webcam state: {e}\n— Djinn"

