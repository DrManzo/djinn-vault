COMPACT_MODE  = False   # no markdown, shorter max_tokens

# ── Shell runner ──────────────────────────────────────────────────────────────

def run_shell(cmd, timeout=30):
    """Run a shell command, return (stdout, stderr, returncode)."""
    try:
        r = subprocess.run(
            cmd, shell=True, capture_output=True, text=True,
            timeout=timeout,
            env={**os.environ, "HOME": os.path.expanduser("~")}
        )
        return r.stdout.strip(), r.stderr.strip(), r.returncode
    except subprocess.TimeoutExpired:
        return "", "Command timed out.", 1
    except Exception as e:
        return "", str(e), 1

# ── Ollama caller ─────────────────────────────────────────────────────────────

IDENTITY = _load_identity()

def get_ctx(query: str) -> str:
    try:
        r = subprocess.run(
            ["djinn-ctx-assembler", query, "--budget", "3000"],
            capture_output=True, text=True, timeout=10
        )
        return r.stdout.strip()
    except Exception:
        return ""

def ask_model(user_msg, context=None):
    djinn_ctx = get_ctx(user_msg)
    system = IDENTITY
    if djinn_ctx:
        system = f"{IDENTITY}\n\n[Vault context]\n{djinn_ctx}"
    if COMPACT_MODE:
        system += "\n\nOUTPUT RULES: You are on a small mobile screen. No markdown. No bold, no bullets, no headers. Plain sentences only. Keep responses under 150 words."

    messages = [{"role": "system", "content": system}]
    if context:
        messages.append({
            "role": "user",
            "content": (
                f"[Command output — format this for Javier. Be concise.]\n\n"
                f"{context}\n\n"
                f"[Original command: {user_msg}]"
            )
        })
    else:
        messages.append({"role": "user", "content": user_msg})

    max_tokens = 400 if COMPACT_MODE else 1024
    try:
        r = requests.post(
            GROQ_URL,
            json={"model": MODEL, "messages": messages, "temperature": 0.4, "max_tokens": max_tokens},
            headers={"Authorization": f"Bearer {_groq_key()}", "Content-Type": "application/json"},
            timeout=60,
        )
        r.raise_for_status()
        text = r.json()["choices"][0]["message"]["content"].strip()
        return text or "— Djinn"
    except Exception as e:
        log.error("Groq error: %s — falling back to Ollama", e)
        try:
            fb = requests.post(
                "http://localhost:11434/api/chat",
                json={"model": "deepseek-r1:7b", "messages": messages, "stream": False,
                      "options": {"temperature": 0.4, "num_predict": 512}},
                timeout=60,
            )
            text = fb.json().get("message", {}).get("content", "").strip()
            text = re.sub(r"<think>.*?</think>", "", text, flags=re.DOTALL).strip()
            return text or "— Djinn"
        except Exception as e2:
            return f"[Djinn unavailable: {e2}]"

