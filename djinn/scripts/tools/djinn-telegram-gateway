def handle_engrave(match, _raw):
    """
    engrave <job_id> <description>
    engrave <stl_path> <description>
    Runs EngravingAgent on the specified job/STL and returns 3 proposals.
    """
    try:
        from agent.orchestrator import orchestrator
    except ImportError as e:
        return f"Engraving agent not available: {e}"

    arg1 = match.group(1).strip()
    request = match.group(2).strip()

    # Determine if arg1 is a job ID (integer) or a file path
    if arg1.isdigit():
        job_id = int(arg1)
        try:
            state = orchestrator.run(
                user_input=request,
                job_id=job_id,
                engrave_request=request,
            )
        except Exception as e:
            return f"Engrave failed for job {job_id}: {e}"
    else:
        # Treat as STL path
        stl_path = arg1
        if not _pl.Path(stl_path).exists():
            # Try under printer-files/queue
            alt = _pl.Path.home() / "printer-files/queue" / stl_path
            if alt.exists():
                stl_path = str(alt)
            else:
                return f"STL not found: {stl_path}"
        try:
            state = orchestrator.run(
                user_input=request,
                engrave_request=request,
            )
            state.source_stl = stl_path
            state.model_path = stl_path
            state.engraving_request = request
            from agent.orchestrator.agents import engrave as _eng
            from agent.orchestrator.llm import LLM
            state = _eng.run(state, LLM())
            state.save()
        except Exception as e:
            return f"Engrave analysis failed: {e}"

    proposals = state.engraving_proposals
    if not proposals or state.status == 'engrave_error':
        return f"Engrave error (job #{state.id}): {state.note}"

    lines = [
        f"🔍 Job #{state.id} — Engraving Analysis",
        f"Request understood: {proposals.get('request_understood', request)}",
        f"Geometry: {proposals.get('geometry_notes', '—')}",
        "",
    ]
    for p in proposals.get('proposals', []):
        lines.append(f"[{p['rank']}] {p['label']} (score {p['engravability_score']})")
        lines.append(f"    {p['position_description']}")
        lines.append(f"    {p['style']} · depth {p['depth_mm']}mm · font {p['font_height_mm']}mm")
        lines.append(f"    {p['rationale']}")
        for w in p.get('warnings', []):
            lines.append(f"    ⚠ {w}")
        lines.append("")

    if proposals.get('hard_blocks'):
        for b in proposals['hard_blocks']:
            lines.append(f"✗ BLOCKED: {b}")

    lines.append(f"Reply: approve engrave 1  /  approve engrave 2  /  approve engrave 3")
    lines.append(f"(job #{state.id})")
    return "\n".join(lines)


def handle_approve_engrave(match, _raw):
    """
    approve engrave <N>
    approve engrave <N> <job_id>
    Approves proposal N for the most recent (or specified) engrave job.
    """
    try:
        from agent.orchestrator import orchestrator
        from agent.orchestrator.project_state import _load_queue
    except ImportError as e:
        return f"Orchestrator not available: {e}"

    choice = int(match.group(1))
    job_id_str = match.group(2).strip() if match.group(2) else ""

    if job_id_str.isdigit():
        job_id = int(job_id_str)
    else:
        # Find most recent job with status engrave_pending_approval
        queue = _load_queue()
        pending = [j for j in queue.get('jobs', [])
                   if j.get('status') == 'engrave_pending_approval']
        if not pending:
            return "No engraving pending approval. Run engrave first."
        job_id = pending[-1]['id']

    try:
        state = orchestrator.approve_engrave(job_id, choice)
    except Exception as e:
        return f"Approve failed: {e}"

    spec = state.engraving_spec
    if not spec:
        return f"Approval recorded for job #{job_id} but no spec returned."

    lines = [
        f"✅ Engraving approved — job #{job_id}",
        f"   {spec.get('label', '')}",
        f"   {spec.get('style', 'deboss')} · depth {spec.get('depth_mm')}mm · "
        f"font {spec.get('font_height_mm')}mm",
        f"   {spec.get('position_description', '')}",
    ]
    if spec.get('warnings'):
        for w in spec['warnings']:
            lines.append(f"   ⚠ {w}")
    lines.append("")
    lines.append("Run  slice N  to slice, or hand off to djinn-model-text-engrave.")
    return "\n".join(lines)


