#!/usr/bin/env bash
# djinn-vault-sync — mirror the vault clone to Alexandria SSD
# Usage: djinn-vault-sync [--snapshot]
#   --snapshot  also save a dated copy in vault-snapshots/YYYY-MM-DD/
#
# Host-independent: Alexandria's mount point/device letter and the vault's
# clone path both differ by machine (was /mnt/alexandria + ~/Obsidian on
# Salomon; is /run/media/drmanzo/Alexandria + ~/djinn-vault on Oroborus,
# since the drive physically moved 2026-07-18 without anyone updating this).

set -euo pipefail

SSD="/run/media/drmanzo/Alexandria"
if [[ -d "$HOME/Obsidian" ]]; then
    VAULT="$HOME/Obsidian"
elif [[ -d "$HOME/djinn-vault" ]]; then
    VAULT="$HOME/djinn-vault"
else
    echo "ERROR: no vault clone found at ~/Obsidian or ~/djinn-vault"
    exit 1
fi
MIRROR="$SSD/vault-snapshots/current"
SNAP_DIR="$SSD/vault-snapshots"

if ! mountpoint -q "$SSD"; then
    echo "ERROR: Alexandria not mounted at $SSD"
    exit 1
fi

echo "Syncing vault → $MIRROR"
rsync -a --delete "$VAULT/" "$MIRROR/"
echo "Done. $(du -sh "$MIRROR" | cut -f1) written."

if [[ "${1:-}" == "--snapshot" ]]; then
    DATE=$(date +%Y-%m-%d)
    DEST="$SNAP_DIR/$DATE"
    if [[ -d "$DEST" ]]; then
        echo "Snapshot $DATE already exists — skipping."
    else
        echo "Creating snapshot → $DEST"
        cp -al "$MIRROR" "$DEST"
        echo "Snapshot done."
    fi
    # Keep last 7 dated snapshots
    ls -d "$SNAP_DIR"/20*/ 2>/dev/null | sort | head -n -7 | while read -r old; do
        echo "Pruning old snapshot: $old"
        rm -rf "$old"
    done
fi
