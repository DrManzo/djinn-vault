#!/bin/bash
# djinn-sync — Pull vault, check COMMS.md, log status to CHANGELOG

set -euo pipefail

VAULT="$HOME/Obsidian"
DJINN="$VAULT/djinn"
CHANGELOG="$DJINN/communications/CHANGELOG.md"
COMMS="$DJINN/communications/COMMS.md"
TIMESTAMP=$(date '+%Y-%m-%d %H:%M')

cd "$VAULT"

# Pull latest
git pull --quiet

# Count unread messages (entries since last sync)
NEW_MESSAGES=$(grep -c "^### " "$COMMS" 2>/dev/null || echo "0")

echo "Sync complete — $TIMESTAMP"
echo "  COMMS.md entries: $NEW_MESSAGES"

# Log to changelog
echo "| $TIMESTAMP | Salomon | Synced | djinn/communications/ | djinn-sync run — COMMS.md entries: $NEW_MESSAGES |" >> "$CHANGELOG"

# Commit only vault markdown files — never binaries or untracked junk
if [ -n "$(git status --porcelain -- djinn/)" ]; then
    git add djinn/
    git -c user.name="Claude" -c user.email="claude@djinn" \
        commit -m "djinn-sync: vault pull + status log $TIMESTAMP"
    export DJINN_AGENT="@Salomon"
    git push --quiet
    echo "  Changes committed and pushed"
else
    echo "  No changes to commit"
fi
