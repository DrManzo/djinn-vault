#!/usr/bin/env bash
# djinn-session-end v2 — enforce session reporting + build real commit message from git state
# Usage:
#   djinn-session-end <topic>              # stage all, commit with real message, push
#   djinn-session-end <topic> --no-push   # commit but don't push
#   djinn-session-end --push-only         # push what's already staged/committed

set -euo pipefail

VAULT="${HOME}/Obsidian"
REPORTS_DIR="${VAULT}/djinn/logs/reports"
BUILD_LOG="${VAULT}/djinn/logs/build-log.md"
COMMS="${VAULT}/djinn/communications/COMMS.md"

# ── Parse args ────────────────────────────────────────────────────────────────
PUSH_ONLY=false
NO_PUSH=false
SESSION_SLUG="unknown-session"

for arg in "$@"; do
    case "$arg" in
        --push-only) PUSH_ONLY=true ;;
        --no-push)   NO_PUSH=true ;;
        --*)         ;; # ignore unknown flags
        *)           SESSION_SLUG="$arg" ;;
    esac
done

DATE=$(date +%Y-%m-%d)
TIME=$(date +%H:%M)

# ── Agent detection ───────────────────────────────────────────────────────────
AGENT="Unknown"
if [[ -n "${OPENCODE_SESSION:-}" || "$(whoami)" == "drmanzo" ]]; then
    AGENT="Salomon"
fi
if [[ "$(whoami)" == "tf-tthq" ]]; then
    AGENT="Typhon"
fi

# ── Push-only shortcut ────────────────────────────────────────────────────────
if [[ "$PUSH_ONLY" == true ]]; then
    cd "${VAULT}"
    if git push 2>/dev/null; then
        SHA=$(git rev-parse --short HEAD)
        echo "✅ Pushed: ${SHA}"
        cat >> "${COMMS}" << COMMSENTRY

### ${DATE} ${TIME} UTC — @${AGENT} → @All: session push ${SHA}

Pushed vault. SHA: \`${SHA}\`

— ${AGENT}
COMMSENTRY
    else
        echo "❌ Push failed (Gateway blocking? Run: djinn-gateway dev)"
        exit 1
    fi
    exit 0
fi

# ── Build commit message from git state ───────────────────────────────────────
_build_commit_msg() {
    local topic="$1"
    cd "${VAULT}"

    # Stage everything first
    git add -A 2>/dev/null || true

    # Diff stat (top 10 files)
    local diff_stat
    diff_stat=$(git diff --cached --stat 2>/dev/null | head -11 || echo "(nothing staged)")

    # File count and first changed file
    local file_count first_file
    file_count=$(git diff --cached --name-only 2>/dev/null | wc -l | tr -d ' ')
    first_file=$(git diff --cached --name-only 2>/dev/null | head -1 || echo "vault")

    # Short description: topic + file summary
    local short_desc
    if (( file_count > 1 )); then
        short_desc="${topic}: ${first_file} + $((file_count - 1)) more"
    elif (( file_count == 1 )); then
        short_desc="${topic}: ${first_file}"
    else
        short_desc="${topic}: no changes"
    fi
    # Trim to 72 chars
    short_desc="${short_desc:0:72}"

    # Scrape last 3 COMMS entry subjects (### ... lines, skip heartbeats)
    local comms_subjects
    comms_subjects=$(grep "^### " "${COMMS}" 2>/dev/null \
        | grep -v "heartbeat\|HEARTBEAT\|vault-sync\|Typhon.*UTC\|Salomon.*UTC\|CHECKPOINT" \
        | tail -3 \
        | sed 's/^### /  - /' || echo "  - (no recent entries)")

    printf '%s\n\nChanged:\n%s\n\nSession context:\n%s\n\nCo-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>' \
        "$short_desc" "$diff_stat" "$comms_subjects"
}

# Check if a report was written today for this session
REPORT_EXISTS=$(find "${REPORTS_DIR}" -name "${DATE}_*.md" -newer "${VAULT}/djinn/communications/HEARTBEAT.md" 2>/dev/null | head -1)

if [[ -z "$REPORT_EXISTS" ]]; then
    # No report found — generate a stub and warn
    REPORT_FILE="${REPORTS_DIR}/${DATE}_${SESSION_SLUG}-stub.md"
    cat > "${REPORT_FILE}" << STUB
---
title: Session Report — ${SESSION_SLUG} (AUTO-STUB)
agent: ${AGENT}
date: ${DATE}
tags: [djinn, report, auto-stub]
stub: true
---

# Session Report — ${SESSION_SLUG}

> ⚠️ **AUTO-GENERATED STUB** — Agent did not write a full report. This is a placeholder.
> Update this file with the actual session details.

**Date:** ${DATE} ${TIME}
**Agent:** ${AGENT}
**Summary:** ${SUMMARY}

---

## What Happened

${SUMMARY}

---

## Files Modified

*Not recorded — agent did not file a full report.*

---

## Action Required

Replace this stub with a complete report following \`djinn/logs/REPORT-TEMPLATE.md\`.

---

*— AUTO-STUB generated by djinn-session-end, ${DATE}*
STUB

    echo "⚠️  No report found for today. Stub created: ${REPORT_FILE}"

    # Append to build-log
    echo "" >> "${BUILD_LOG}"
    echo "## ${DATE}: AUTO-STUB — ${SESSION_SLUG}" >> "${BUILD_LOG}"
    echo "- ${SUMMARY}" >> "${BUILD_LOG}"
    echo "- ⚠️ Full report not filed — stub at \`logs/reports/${DATE}_${SESSION_SLUG}-stub.md\`" >> "${BUILD_LOG}"
    echo "*— ${AGENT}*" >> "${BUILD_LOG}"

    # Send Telegram warning if credentials available
    TELEGRAM_TOKEN="${DJINN_TELEGRAM_TOKEN:-}"
    CHAT_ID="${DJINN_CHAT_ID:-}"
    if [[ -n "$TELEGRAM_TOKEN" && -n "$CHAT_ID" ]]; then
        MSG="⚠️ ${AGENT} session ended WITHOUT a report.
Session: ${SESSION_SLUG}
Summary: ${SUMMARY}
A stub was auto-created. Please update it."
        curl -s -X POST "https://api.telegram.org/bot${TELEGRAM_TOKEN}/sendMessage" \
            -d chat_id="${CHAT_ID}" \
            -d text="${MSG}" > /dev/null
        echo "⚠️  Telegram warned: no report filed"
    fi

else
    echo "✅ Report found: ${REPORT_EXISTS}"
fi

# Append to COMMS.md
cat >> "${COMMS}" << COMMSENTRY

---

**FROM:** ${AGENT,,}
**TO:** all
**DATE:** ${DATE} ${TIME}
**RE:** Session end — ${SESSION_SLUG}

${SUMMARY}

**Action:** None — FYI.

— ${AGENT}
COMMSENTRY
echo "✅ COMMS.md updated"

# ── Generate SESSION-RESUME.md for next session startup ───────────────────────
SESSION_RESUME="${VAULT}/djinn/SESSION-RESUME.md"
{
  echo "---"
  echo "generated: $(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  echo "---"
  echo "# SESSION-RESUME — Quick Context"
  echo ""
  echo "## Active Queue"
  grep "^\- \[ \]" "${VAULT}/QUEUE.md" 2>/dev/null | head -10 || echo "(empty)"
  echo ""
  echo "## Last 3 COMMS Entries"
  grep -A4 "^### " "${COMMS}" 2>/dev/null | tail -20
  echo ""
  echo "## System State Snapshot"
  tail -30 "${VAULT}/SYSTEM-STATE.md" 2>/dev/null || echo "(unavailable)"
} > "$SESSION_RESUME"
echo "✅ SESSION-RESUME.md updated"

# ── Commit with real message ──────────────────────────────────────────────────
cd "${VAULT}"
COMMIT_MSG=$(_build_commit_msg "${SESSION_SLUG}")

if git diff --cached --quiet 2>/dev/null; then
    echo "ℹ️  Nothing staged to commit"
else
    git commit -m "${COMMIT_MSG}"
    SHA=$(git rev-parse --short HEAD)
    echo "✅ Committed: ${SHA}"

    # Real COMMS entry with SHA
    cat >> "${COMMS}" << COMMSENTRY

### ${DATE} ${TIME} UTC — @${AGENT} → @All: session end — ${SESSION_SLUG}

Session closed. Commit: \`${SHA}\`

— ${AGENT}
COMMSENTRY
fi

# Push unless --no-push
if [[ "$NO_PUSH" == false ]]; then
    if git push 2>/dev/null; then
        echo "✅ Vault pushed"
    else
        echo "❌ Push blocked — run 'djinn-gateway dev' then retry with: djinn-session-end --push-only"
    fi
fi
