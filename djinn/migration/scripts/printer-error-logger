#!/usr/bin/env python3
"""
printer-error-logger — polls Moonraker every 30s.
  - Logs errors to error_log.md
  - Logs status readings to print_monitor_log.md (every 60s while printing)
  - Synthesizes print_profile_baseline.md after 10+ readings or on completion
Runs as a systemd user service — no terminal needed.
"""

import json, time, sys, os, statistics
from datetime import datetime, timezone
from pathlib import Path
import urllib.request, urllib.error

_DELTA_GUARD_PATH = str(Path.home() / "Obsidian/djinn/tools/delta-guard")
if _DELTA_GUARD_PATH not in sys.path:
    sys.path.insert(0, _DELTA_GUARD_PATH)
from delta_guard import should_fire
from timer_states import normalize_state

MOONRAKER    = "http://192.168.1.113:7125"
LOG_PATH     = Path.home() / "Obsidian/djinn/printer/error_log.md"
MONITOR_PATH = Path.home() / "Obsidian/djinn/printer/print_monitor_log.md"
PROFILE_PATH = Path.home() / "Obsidian/djinn/printer/config/print_profile_baseline.md"
SEEN_PATH    = Path.home() / ".cache/djinn/printer_seen_jobs.json"
LAST_ERR_FILE = Path.home() / ".cache/djinn/last-printer-error"
POLL_SEC     = 30
MONITOR_EVERY = 60  # seconds between monitor rows

_last_monitor_ts  = 0
_monitor_rows     = []   # in-memory list of dicts for profile synthesis
_profile_done_for = None  # filename we already synthesized


def get(path):
    try:
        with urllib.request.urlopen(f"{MOONRAKER}{path}", timeout=5) as r:
            return json.loads(r.read())["result"]
    except Exception as e:
        return None


def post(path, body):
    try:
        data = json.dumps(body).encode()
        req  = urllib.request.Request(
            f"{MOONRAKER}{path}", data=data,
            headers={"Content-Type": "application/json"}, method="POST"
        )
        with urllib.request.urlopen(req, timeout=5) as r:
            return json.loads(r.read())["result"]
    except Exception:
        return None


def now_str():
    return datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M UTC")


def ensure_log():
    LOG_PATH.parent.mkdir(parents=True, exist_ok=True)
    if not LOG_PATH.exists():
        LOG_PATH.write_text(
            "# Printer Error Log\n\n"
            "Auto-generated by printer-error-logger.\n"
            "Each entry is a detected issue with notes for follow-up.\n\n"
        )


def load_seen():
    SEEN_PATH.parent.mkdir(parents=True, exist_ok=True)
    if SEEN_PATH.exists():
        return set(json.loads(SEEN_PATH.read_text()))
    return set()


def save_seen(seen):
    SEEN_PATH.write_text(json.dumps(list(seen)))


def append_entry(entry: str):
    ensure_log()
    with LOG_PATH.open("a") as f:
        f.write(entry)
    print(f"[{now_str()}] logged: {entry[:80].strip()}")


def get_last_known_error() -> str:
    try:
        return LAST_ERR_FILE.read_text().strip()
    except FileNotFoundError:
        return ""


def save_last_error(msg: str):
    LAST_ERR_FILE.parent.mkdir(parents=True, exist_ok=True)
    LAST_ERR_FILE.write_text(msg)


def check_watchdog_errors():
    """Read wd_pending_error from save_variables, log if new, then clear it."""
    result = post("/printer/objects/query", {"objects": {"save_variables": None}})
    if not result:
        return
    variables = result.get("status", {}).get("save_variables", {}).get("variables", {})
    msg = variables.get("wd_pending_error", "")
    if msg and msg not in ('""', "''", ""):
        clean = msg.strip('"\'')
        # Dedup — skip if same error as last poll
        if clean == get_last_known_error():
            return
        save_last_error(clean)
        entry = (
            f"## {now_str()} — Watchdog Alert\n\n"
            f"- **Error:** `{clean}`\n"
            f"- **Status:** unresolved\n"
            f"- **Fix:** \n\n"
        )
        append_entry(entry)
        # Clear the pending flag
        post("/printer/gcode/script",
             {"script": 'SAVE_VARIABLE VARIABLE=wd_pending_error VALUE=\'""\''}
        )


def check_job_history(seen: set) -> set:
    """Check Moonraker job history for new failed/cancelled jobs."""
    history = get("/server/history/list?limit=20&order=desc")
    if not history:
        return seen
    jobs = history.get("jobs", [])
    for job in jobs:
        jid    = job.get("job_id", "")
        status = job.get("status", "")
        if jid in seen:
            continue
        seen.add(jid)
        if status in ("error", "cancelled"):
            fname    = job.get("filename", "unknown")
            start    = job.get("start_time", 0)
            end      = job.get("end_time", 0)
            duration = f"{(end - start)/60:.1f}m" if end and start else "?"
            err_msg  = job.get("error_message") or status
            ts       = datetime.fromtimestamp(start, tz=timezone.utc).strftime("%Y-%m-%d %H:%M UTC") if start else now_str()
            entry = (
                f"## {ts} — Job {status.upper()}\n\n"
                f"- **File:** `{fname}`\n"
                f"- **Duration before stop:** {duration}\n"
                f"- **Error:** `{err_msg}`\n"
                f"- **Status:** unresolved\n"
                f"- **Fix:** \n\n"
            )
            append_entry(entry)
    return seen


def ensure_monitor_log():
    MONITOR_PATH.parent.mkdir(parents=True, exist_ok=True)
    if not MONITOR_PATH.exists():
        MONITOR_PATH.write_text(
            "# Print Monitor Log\n\n"
            "| Timestamp | State | Progress | Hotend °C | Target | Bed °C | Target | Fan % | Speed mm/s | File |\n"
            "|---|---|---|---|---|---|---|---|---|---|\n"
        )


def log_monitor_row(status: dict):
    global _last_monitor_ts, _monitor_rows, _profile_done_for
    now = time.time()
    if now - _last_monitor_ts < MONITOR_EVERY:
        return
    _last_monitor_ts = now

    ps  = status.get("print_stats") or {}
    ext = status.get("extruder") or {}
    bed = status.get("heater_bed") or {}
    fan = status.get("fan") or {}
    th  = status.get("toolhead") or {}

    state = ps.get("state", "?")
    prog  = ps.get("progress", 0) * 100
    ht    = ext.get("temperature", 0)
    htgt  = ext.get("target", 0)
    bt    = bed.get("temperature", 0)
    btgt  = bed.get("target", 0)
    fp    = fan.get("speed", 0) * 100
    spd   = th.get("requested_speed", 0)
    fname = ps.get("filename", "—")
    ts    = now_str()

    ensure_monitor_log()
    row = f"| {ts} | {state} | {prog:.1f}% | {ht:.1f} | {htgt:.0f} | {bt:.1f} | {btgt:.0f} | {fp:.0f}% | {spd:.0f} | {fname} |"
    with MONITOR_PATH.open("a") as f:
        f.write(row + "\n")
    print(f"[{ts}] monitor: {state} {prog:.1f}% hotend={ht:.1f}C")

    if state in ("printing", "paused") and htgt > 0:
        _monitor_rows.append({"ts": ts, "state": state, "prog": prog,
                               "ht": ht, "htgt": htgt, "bt": bt, "btgt": btgt,
                               "fan": fp, "spd": spd, "file": fname})

    should_synthesize = (
        len(_monitor_rows) >= 10 or state == "complete"
    ) and _profile_done_for != fname and len(_monitor_rows) >= 3

    if should_synthesize:
        synthesize_profile(fname)
        _profile_done_for = fname


def synthesize_profile(fname: str):
    rows = _monitor_rows
    if not rows:
        return
    ts = now_str()
    htemps  = [r["ht"]  for r in rows]
    btemps  = [r["bt"]  for r in rows]
    fans    = [r["fan"] for r in rows]
    speeds  = [r["spd"] for r in rows if r["spd"] > 0]
    htgt    = rows[0]["htgt"]
    btgt    = rows[0]["btgt"]

    ht_mean  = statistics.mean(htemps)
    ht_std   = statistics.stdev(htemps) if len(htemps) > 1 else 0
    ht_min   = min(htemps); ht_max = max(htemps)
    bt_mean  = statistics.mean(btemps)
    bt_std   = statistics.stdev(btemps) if len(btemps) > 1 else 0
    fan_ramp = "instant" if fans[0] > 50 else ("gradual" if max(fans) > 0 else "off")
    spd_mean = statistics.mean(speeds) if speeds else 0
    anomalies = []
    if ht_std > 3:
        anomalies.append(f"hotend temp variance high: ±{ht_std:.1f}°C (check nozzle_mcu cable)")
    if bt_std > 2:
        anomalies.append(f"bed temp variance high: ±{bt_std:.1f}°C")
    if any(r["ht"] < r["htgt"] - 15 for r in rows):
        anomalies.append("hotend dropped >15°C below target at least once")

    profile = f"""# Print Profile Baseline
Generated: {ts}
Source file: {fname}
Readings: {len(rows)}

## Temperatures
| | Hotend | Bed |
|---|---|---|
| Target | {htgt:.0f}°C | {btgt:.0f}°C |
| Mean | {ht_mean:.1f}°C | {bt_mean:.1f}°C |
| Std dev | ±{ht_std:.2f}°C | ±{bt_std:.2f}°C |
| Range | {ht_min:.1f}–{ht_max:.1f}°C | {min(btemps):.1f}–{max(btemps):.1f}°C |

## Fan
- Ramp pattern: {fan_ramp}
- Max speed seen: {max(fans):.0f}%
- Min speed seen: {min(fans):.0f}%

## Speed
- Mean requested speed: {spd_mean:.0f} mm/s
- Max: {max(speeds) if speeds else 0:.0f} mm/s

## Anomalies
{"- " + chr(10) + "- ".join(anomalies) if anomalies else "None detected"}

## Notes
- nozzle_mcu cable needs reseating (hardware fix pending)
- verify_heater extruder set to max tolerance (999/999) as workaround
"""
    PROFILE_PATH.parent.mkdir(parents=True, exist_ok=True)
    PROFILE_PATH.write_text(profile)
    print(f"[{ts}] profile saved to {PROFILE_PATH}")


def main():
    global _last_monitor_ts
    print(f"[{now_str()}] printer-error-logger started (poll every {POLL_SEC}s)")
    ensure_log()
    ensure_monitor_log()
    seen = load_seen()
    while True:
        try:
            result = post("/printer/objects/query",
                          {"objects": {"print_stats": None, "extruder": None,
                                       "heater_bed": None, "fan": None, "toolhead": None}})
            if result:
                status = result.get("status", {})
                ps = status.get("print_stats") or {}
                printer_state = ps.get("state", "unknown")
                current_file  = ps.get("filename", "")

                # Gate expensive actions behind printer state delta
                raw_state = {
                    "printer_state": printer_state,
                    "current_file":  current_file,
                }
                norm_state = normalize_state(raw_state, "printer-error-logger")
                state_changed = should_fire(norm_state, "printer-error-logger")

                log_monitor_row(status)

                if state_changed:
                    check_watchdog_errors()
                    seen = check_job_history(seen)
                    save_seen(seen)

        except Exception as e:
            print(f"[{now_str()}] poll error: {e}", file=sys.stderr)
        time.sleep(POLL_SEC)


if __name__ == "__main__":
    main()
