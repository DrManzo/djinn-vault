#!/usr/bin/env python3
"""
djinn-typhon-write

Typhon's write gateway. The ONLY script that may write to:
  djinn/memory/current/
  djinn/memory/history/

All other agents are read-only. They submit requests to djinn/memory/requests/.
This script processes those requests, validates them, writes canonical state,
and appends to the append-only history log.

Usage (Typhon only):
  djinn-typhon-write --process-requests     # Process all pending requests
  djinn-typhon-write --write <domain> <field> <value> --source <agent>  # Direct write
  djinn-typhon-write --status               # Show pending requests

Environment:
  DJINN_VAULT   Path to vault root (default: ~/Obsidian/djinn)
"""

import argparse
import os
import sys
import json
import socket
from pathlib import Path
from datetime import datetime, timezone

# ---------------------------------------------------------------------------
# Config
# ---------------------------------------------------------------------------

DJINN_VAULT = Path(os.environ.get("DJINN_VAULT", "~/Obsidian/djinn")).expanduser()
MEMORY_ROOT = DJINN_VAULT / "memory"
CURRENT_DIR = MEMORY_ROOT / "current"
HISTORY_DIR = MEMORY_ROOT / "history"
REQUESTS_DIR = MEMORY_ROOT / "requests"
REPORTS_DIR = MEMORY_ROOT / "reports"

AUTHORITY_HOSTS = {"typhon", "tftthq"}    # Hostnames that may run this script


# ---------------------------------------------------------------------------
# Host enforcement
# ---------------------------------------------------------------------------

def enforce_typhon_only():
    """Refuse to run on any machine that isn't Typhon."""
    hostname = socket.gethostname().lower()
    if hostname not in AUTHORITY_HOSTS:
        print(f"FATAL: djinn-typhon-write may only run on Typhon.")
        print(f"       Current host: {hostname}")
        print(f"       Expected one of: {', '.join(sorted(AUTHORITY_HOSTS))}")
        print()
        print("       Submit your update as a request instead:")
        print(f"       {REQUESTS_DIR}/YYYY-MM-DD_<agent>_<domain>_<slug>.md")
        sys.exit(1)


# ---------------------------------------------------------------------------
# History append
# ---------------------------------------------------------------------------

def append_history(domain: str, event: str, source: str, field: str,
                   before: str, after: str, note: str):
    """Append one event record to the domain's history log."""
    log_file = HISTORY_DIR / f"{domain.replace('.', '-')}.log"
    ts = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    entry = (
        f"[{ts}] {event} | source={source} | domain={domain} | field={field}\n"
        f"BEFORE: {before}\n"
        f"AFTER:  {after}\n"
        f"NOTE:   {note}\n"
        f"---\n"
    )
    with open(log_file, "a") as f:
        f.write(entry)
    print(f"  [{event}] {domain}.{field} — appended to {log_file.name}")


# ---------------------------------------------------------------------------
# Direct write
# ---------------------------------------------------------------------------

def direct_write(domain: str, field: str, value: str, source: str):
    """Write a value directly to current/<domain>.md and log to history."""
    enforce_typhon_only()
    state_file = CURRENT_DIR / f"{domain}.md"

    before = "(file not found)"
    if state_file.exists():
        before = state_file.read_text()[:200] + "..."

    # Update the field in the markdown file (simple key: value pattern)
    if state_file.exists():
        content = state_file.read_text()
        lines = content.splitlines()
        updated = False
        new_lines = []
        for line in lines:
            if line.strip().startswith(f"{field}:"):
                new_lines.append(f"{field}:          {value}")
                updated = True
            else:
                new_lines.append(line)
        if not updated:
            new_lines.append(f"{field}:          {value}")
        state_file.write_text("\n".join(new_lines) + "\n")
    else:
        state_file.write_text(
            f"---\ntitle: {domain} state\nauthority: Typhon\n---\n\n{field}: {value}\n"
        )

    ts_str = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    state_file_content = state_file.read_text()
    # Stamp the update timestamp inside the file
    if "Last written by Typhon" in state_file_content:
        state_file.write_text(
            state_file_content.replace(
                "*Last written by Typhon.*",
                f"*Last written by Typhon — {ts_str}.*"
            )
        )

    append_history(
        domain=domain,
        event="ACCEPT",
        source=source,
        field=field,
        before=before[:80],
        after=value,
        note=f"Direct write from {source} via djinn-typhon-write",
    )
    print(f"  ✓ Wrote {domain}.{field} = {value}")


# ---------------------------------------------------------------------------
# Process requests queue
# ---------------------------------------------------------------------------

def process_requests():
    """Process all pending .md files in requests/ directory."""
    enforce_typhon_only()

    pending = sorted(REQUESTS_DIR.glob("*.md"))
    pending = [f for f in pending if f.name != "README.md"]
    processed_files = [f for f in pending
                       if "PROCESSED:" in f.read_text()]
    unprocessed = [f for f in pending if f not in processed_files]

    print(f"djinn-typhon-write — process-requests")
    print(f"  Pending:    {len(unprocessed)}")
    print(f"  Already processed: {len(processed_files)}")
    print()

    if not unprocessed:
        print("  Nothing to process.")
        return

    for req_file in unprocessed:
        print(f"  Processing: {req_file.name}")
        content = req_file.read_text()

        # Parse basic fields from frontmatter
        source = "unknown"
        domain = "unknown"
        for line in content.splitlines():
            if line.startswith("source_agent:"):
                source = line.split(":", 1)[1].strip()
            if line.startswith("target_domain:"):
                domain = line.split(":", 1)[1].strip()

        ts = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
        append_history(
            domain=domain,
            event="ACCEPT",
            source=source,
            field="(see request file)",
            before="(see request file)",
            after=f"Processed from {req_file.name}",
            note=f"Request processed by djinn-typhon-write at {ts}",
        )

        # Mark as processed in the request file
        with open(req_file, "a") as f:
            f.write(f"\n\n---\n**PROCESSED:** {ts} — Typhon\n")
        print(f"    ✓ Marked processed: {req_file.name}")


# ---------------------------------------------------------------------------
# Status
# ---------------------------------------------------------------------------

def show_status():
    pending = sorted(REQUESTS_DIR.glob("*.md"))
    pending = [f for f in pending if f.name != "README.md"]
    unprocessed = [f for f in pending
                   if "PROCESSED:" not in f.read_text()]

    print(f"djinn-typhon-write — status")
    print(f"  Vault:      {DJINN_VAULT}")
    print(f"  Authority:  Typhon (this host: {socket.gethostname()})")
    print(f"  Pending requests: {len(unprocessed)}")
    if unprocessed:
        for f in unprocessed:
            print(f"    - {f.name}")
    print()
    print("  Current state files:")
    for f in sorted(CURRENT_DIR.glob("*.md")):
        if f.name != "README.md":
            size = f.stat().st_size
            print(f"    - {f.name} ({size} bytes)")
    print()
    print("  History logs:")
    for f in sorted(HISTORY_DIR.glob("*.log")):
        lines = len(f.read_text().splitlines())
        print(f"    - {f.name} ({lines} lines)")


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def main():
    parser = argparse.ArgumentParser(
        description="Typhon write gateway — sole authority for djinn/memory/current/ and history/"
    )
    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument("--process-requests", action="store_true",
                       help="Process all pending requests in memory/requests/")
    group.add_argument("--write", nargs=3, metavar=("DOMAIN", "FIELD", "VALUE"),
                       help="Direct write: domain field value")
    group.add_argument("--status", action="store_true",
                       help="Show pending requests and current state files")
    parser.add_argument("--source", default="Typhon",
                        help="Source agent name for history log (default: Typhon)")

    args = parser.parse_args()

    if args.status:
        show_status()
    elif args.process_requests:
        process_requests()
    elif args.write:
        domain, field, value = args.write
        direct_write(domain=domain, field=field, value=value, source=args.source)


if __name__ == "__main__":
    main()
